{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/attendance/**",
              "components/badges/**",
              "components/brand/**",
              "components/buttons/**",
              "components/calendar/**",
              "components/cards/**",
              "components/comms/**",
              "components/data/**",
              "components/feedback/**",
              "components/formlayout/**",
              "components/forms/**",
              "components/icons/**",
              "components/music/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/people/**",
              "ui_kits/choirbook-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaList'] > JSXAttribute > JSXIdentifier[name!=/^(?:events|today|onEventClick|locale|className|key|ref|className|style|children)$/]",
        "message": "<AgendaList> doesn't accept that prop. Declared props: events, today, onEventClick, locale, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|icon|actions|onDismiss|dismissLabel|className|children|key|ref|className|style|children)$/]",
        "message": "<AlertCard> doesn't accept that prop. Declared props: tone, title, icon, actions, onDismiss, dismissLabel, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|error|accent)$/]",
        "message": "<AlertCard> tone must be one of 'info' | 'success' | 'warning' | 'error' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|role|date|audience|body|pinned|unread|requiresAck|acknowledged|acknowledgedAt|ackDue|onAcknowledge|attachments|href|lang|clamp|className|key|ref|className|style|children)$/]",
