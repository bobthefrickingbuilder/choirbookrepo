# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, set these in Project → Settings → Environment Variables.

# Supabase project (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). Older projects call it the "anon" key; either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. The "secret" key (sb_secret_…), called "service_role" on older projects.
# It bypasses row-level security: set it in Vercel yourself; it must never reach the browser.
SUPABASE_SECRET_KEY=

# The site's public address, used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test mode (Phase 3+). Publishable key is safe; the secret key is server only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email). Server only.
RESEND_API_KEY=
EMAIL_FROM="Choirbook <onboarding@resend.dev>"

# Shared secret for scheduled jobs (keep-alive, nightly demo reset, email queue).
CRON_SECRET=
